# =============================================================================
# Staging (homologação) — TEMPLATE
# =============================================================================
# Este arquivo fica preparado para quando o ambiente de staging existir.
# Copie para .env.staging no servidor de homologação e ajuste os valores.
#
# Para ativar deploy automático de staging no GitHub Actions:
#   1. Configure os secrets STAGING_* no repositório (ver docs/CI_CD.md)
#   2. Defina a variável de repositório STAGING_ENABLED=true
#   3. Ajuste docker-compose.staging.yml com host/porta do staging
# =============================================================================

# Banco de dados de homologação (isolado de produção)
DATABASE_URL=mysql+pymysql://appuser:SENHA_STAGING@HOST_STAGING:3306/operadora_saude_staging

SECRET_KEY=change-me-staging-use-strong-random
PUBLIC_API_TOKENS=

# Admin inicial (somente se o banco staging está vazio)
ADMIN_EMAIL=admin@staging.local
ADMIN_PASSWORD=change-me-staging
ADMIN_NAME=Admin Staging

# Porta exposta no host (evita conflito com prod 8010)
STAGING_WEB_PORT=8011

# Health check URL usado pelo CD (ajuste host/porta do staging)
STAGING_HEALTH_URL=http://HOST_STAGING:8011/health?format=json

# Desabilitar jobs pesados em staging, se necessário
INSUMO_IMPORT_BACKGROUND_DISABLE=1
CBHPM_API_CACHE_TTL=300
