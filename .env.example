MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=sistema_preco
SECRET_KEY=change-me
# In dev (without Docker), override DATABASE_URL below to your local MySQL
# DATABASE_URL=mysql+pymysql://root:@localhost/operadora_saude

# Initial admin seeding (created on first run if no users)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Importação Brasíndice (arquivos 10k+ linhas): lotes 2000 por padrão, teto 4000 — evita pico de memória e
# travamentos no MySQL. Só aumente (ex.: 3000) com servidor e banco com folga.
# BRAS_MATERIALIZE_BATCH_SIZE=2000
# BRAS_INDEX_SYNC_BATCH_SIZE=2000
# BRAS_RAW_CSV_BATCH=2000
# Pausa opcional (ms) entre lotes, para CPU/MySQL aliviar em servidores fracos (0 = off; máx. 5000).
# BRAS_BETWEEN_BATCHES_MS=0

# Reembolso (OCR local)
# REEMBOLSO_STORAGE_DIR=./data/reembolsos
REEMBOLSO_MAX_FILE_MB=12
REEMBOLSO_OCR_MAX_PAGES=2
REEMBOLSO_PDF_TEXT_MIN_CHARS=120
REEMBOLSO_TESSERACT_LANG=por+eng
