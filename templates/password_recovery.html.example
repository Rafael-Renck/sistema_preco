<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Senha - Murta PriceHealth</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>

  <!-- Auth Styles -->
  <link rel="stylesheet" href="{{ url_for('static', filename='css/auth.css') }}" />
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-container">
      <!-- Logo e Título -->
      <div class="auth-header">
        <h1 class="auth-title">Recuperar Senha</h1>
        <p class="auth-subtitle">Digite seu e-mail para receber as instruções</p>
      </div>

      <!-- Mensagem de Sucesso/Erro -->
      {% if mensagem %}
        <div class="auth-alert" role="alert">
          <i class="bi bi-check-circle"></i>
          <div>{{ mensagem }}</div>
        </div>
      {% elif erro %}
        <div class="auth-alert" style="background: #fee2e2; border-color: #fecaca; color: #991b1b;" role="alert">
          <i class="bi bi-exclamation-circle"></i>
          <div>{{ erro }}</div>
        </div>
      {% endif %}

      <!-- Formulário -->
      <form method="post" action="{{ url_for('recuperar_senha') }}" class="auth-content" data-validate>
        <!-- Email Input -->
        <div class="form-group">
          <label for="email" class="form-label">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="seu@email.com"
            required
            autofocus
          />
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-auth">Enviar Instruções</button>
      </form>

      <!-- Footer com Link para Login -->
      <div class="auth-footer">
        <p class="auth-footer-text">
          Lembrou a senha?
          <a href="{{ url_for('login') }}" class="auth-footer-link">Voltar ao login</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Auth Module -->
  <script type="module" src="{{ url_for('static', filename='js/modules/auth.js') }}"></script>
</body>
</html>
